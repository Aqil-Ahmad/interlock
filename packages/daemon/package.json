{
  "name": "@interlock/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Long-running local service: watcher, event bus, scheduler, SQLite store and the localhost HTTP/WS API consumed by the CLI, dashboard and MCP server.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "interlockd": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@interlock/core": "workspace:*",
    "@interlock/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
