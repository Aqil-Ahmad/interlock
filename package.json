{
  "name": "interlock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Early conflict detection and integration intelligence for parallel AI coding agents",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interlock-ai/interlock.git"
  },
  "homepage": "https://github.com/interlock-ai/interlock#readme",
  "bugs": "https://github.com/interlock-ai/interlock/issues",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --stream build",
    "clean": "pnpm -r --stream clean && rm -rf node_modules/.cache",
    "typecheck": "tsc --build --force && tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench.ts",
    "eval": "tsx eval/run.ts",
    "adr": "tsx scripts/new-adr.ts",
    "verify": "pnpm verify:static && pnpm test:coverage",
    "verify:static": "pnpm build && pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
